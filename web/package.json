{
  "name": "apex-forecast-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/generate-types.mjs && node scripts/generate-static-assets.mjs && next build",
    "start": "node scripts/serve-export.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:lifecycles": "node scripts/test-lifecycles.mjs",
    "verify:export": "node scripts/verify-export.mjs",
    "perf:budget": "lhci collect && lhci assert",
    "generate:types": "node scripts/generate-types.mjs"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "d3-scale": "^4.0.2",
    "gsap": "^3.13.0",
    "motion": "^12.23.0",
    "next": "^15.5.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/eslintrc": "^3.3.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.55.0",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.3",
    "json-schema-to-typescript": "^15.0.4",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
